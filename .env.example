# Frontend environment variables
# Copy this file to .env and adjust values for your local setup.

# Backend API base URL (used by the Next.js frontend to call the FastAPI backend)
# Local dev may use http://localhost:8000.
# Production build rejects localhost/127.0.0.1/::1; set this to a real non-localhost API URL before running `npm run build` for production.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Image base URL (used by the frontend to resolve uploaded image paths)
# If not set, defaults to NEXT_PUBLIC_API_URL
# NEXT_PUBLIC_IMAGE_BASE_URL=https://your-cdn.example.com

# Public site URL (used by RSS feed generation)
# Default: http://localhost:2025
# NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# Like button API URL (optional, external like service endpoint)
# If empty, like button uses relative paths
# NEXT_PUBLIC_LIKE_API_URL=https://your-like-api.example.com

# Site URL for sitemap generation (server-side only, not NEXT_PUBLIC_)
# Falls back to VERCEL_URL on Vercel, then http://localhost:3000
# SITE_URL=https://your-domain.example.com

# Blog slug key prefix (server-side only)
# Prepended to blog slugs for namespacing. Leave empty for no prefix.
# BLOG_SLUG_KEY=
