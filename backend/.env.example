# ===========================================
# Backend environment variables
# Copy this file to .env and adjust values.
# Do NOT commit real secrets.
# ===========================================

# --- Runtime ---
ENV=development

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/blog_db

# --- JWT ---
# Generate a random secret for production. Do NOT use the template value.
JWT_SECRET_KEY=your-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed origins. Do not use a JSON array here.
# Example: http://localhost:2025,http://127.0.0.1:2025
ALLOWED_ORIGINS=http://localhost:2025,http://localhost:3000,http://127.0.0.1:2025,http://127.0.0.1:3000

# --- Registration ---
# Enable/disable user registration
ENABLE_REGISTRATION=true
# If set, registration requires this key. Leave empty for open registration.
REGISTRATION_KEY=

# --- AI: General assistant ---
# Default: Qwen3.7 Plus via DashScope OpenAI-compatible endpoint
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.7-plus

# --- AI: DashScope (vision/OCR) ---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus

# --- AI: DeepSeek (text generation/analysis) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# --- AI: Image generation (DashScope) ---
# Used by diagram_service.py for image generation.
# This endpoint is the DashScope image generation API, NOT the OpenAI-compatible chat endpoint.
# DASHSCOPE_IMAGE_API_KEY=
# DASHSCOPE_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro

# --- Keep-alive ---
KEEP_ALIVE_ENABLED=false
KEEP_ALIVE_INTERVAL=300
KEEP_ALIVE_URL=http://127.0.0.1:8000/api/health

# --- Auth bypass (development only) ---
AUTH_BYPASS=false
AUTH_BYPASS_ALLOW=false

# --- WebAuthn / Passkey ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:2025
WEBAUTHN_RP_NAME=Blog Admin

# --- Operator passkey registration ---
# If empty, operator registration endpoints are disabled (fail-closed)
OPERATOR_REGISTRATION_KEY=

# --- Image serving ---
# Base URL for serving uploaded images
IMAGE_BASE_URL=https://public-api.limengyang.me
