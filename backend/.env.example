# 数据库
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/blog_db

# JWT
JWT_SECRET_KEY=your-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI (general model defaults to Qwen3.7 Plus via DashScope)
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.7-plus

# DashScope (vision/OCR uses the general Qwen3.7 Plus model)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus

# DeepSeek (text)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseekv4pro

# Operator passkey registration (required for /api/auth/passkey/operator/* endpoints)
# If empty, operator registration endpoints are disabled (fail-closed)
OPERATOR_REGISTRATION_KEY=
