+            ReviewRecord.new_state.label("new_state"),
+            func.row_number()
+            .over(
+                partition_by=ReviewRecord.review_item_id,
+                order_by=(ReviewRecord.reviewed_at.desc(), ReviewRecord.id.desc()),
