+            count=practice_action.count,
+            target_route=PRACTICE_TARGET_ROUTE,
+            reason=FIRST_ACTION_REASON_PRACTICE_FIRST,
+        )
+    return DashboardTodayFirstAction(
+        kind="none",
+        count=0,
+        target_route=None,
+        reason=FIRST_ACTION_REASON_NOTHING,
+    )
